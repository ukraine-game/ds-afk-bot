DISCORD_TOKEN=PASTE_BOT_TOKEN_HERE
GUILD_ID=PASTE_SERVER_ID_HERE
ADMIN_IDS=
# Railway Volume must be mounted at /data
DB_PATH=/data/bot.db
# Optional. Default: same storage area as the database + /backups
DB_BACKUP_DIR=/data/backups
# Automatic verified backup every 5 minutes
DB_BACKUP_INTERVAL_SECONDS=300
# Number of verified backups to keep
MAX_DB_BACKUPS=30
